# ─── Neon PostgreSQL ─────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Get this from your Neon project dashboard → Connection Details → Connection string
# Change "postgresql://" to "postgresql+asyncpg://" for the async driver.
DATABASE_URL=postgresql+asyncpg://your_user:your_password@ep-your-endpoint.region.aws.neon.tech/your_db?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_STRING

# Access token lifetime in minutes (default: 60)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
